    "Macro.Unavailable.AddressOf" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AddressOf isn’t available in Tables. It is only used with Windows functions, which can’t be called here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables では AddressOf を使用できません。AddressOf は Windows の関数と組み合わせてのみ使われますが、ここでは Windows の関数を呼び出せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables에서는 AddressOf를 사용할 수 없습니다. AddressOf는 Windows 함수와 함께만 사용되며, 여기서는 Windows 함수를 호출할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 不支持 AddressOf。它只与 Windows 函数一起使用，而这里无法调用 Windows 函数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 不支援 AddressOf。它只與 Windows 函數一起使用，而這裡無法呼叫 Windows 函數。"
          }
        }
      }
    },
    "Macro.Unavailable.Declare" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
