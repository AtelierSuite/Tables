    "Help.Functions.FilesNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All within the workbook’s own folder of files; see Working with Files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてブック専用のファイルフォルダ内で動作します。「ファイルの操作」を参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 통합 문서 전용 파일 폴더 안에서 작동합니다. 파일 작업을 참조하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部在工作簿的专属文件夹内进行，请参阅“处理文件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部在活頁簿的專屬資料夾內進行，請參閱「處理檔案」。"
          }
        }
      }
    },
    "Help.Functions.FormatNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format takes the same codes as cell number formats, such as \"#,##0.00\" or \"yyyy-mm-dd\", and named formats such as \"Currency\" and \"Short Date\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format には、\"#,##0.00\" や \"yyyy-mm-dd\" のようなセルの表示形式と同じコードや、\"Currency\"、\"Short Date\" などの名前付き書式を指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format에는 \"#,##0.00\"이나 \"yyyy-mm-dd\" 같은 셀 표시 형식과 같은 코드와 \"Currency\", \"Short Date\" 같은 이름 있는 형식을 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format 使用与单元格数字格式相同的代码，如 \"#,##0.00\" 或 \"yyyy-mm-dd\"，也支持 \"Currency\"、\"Short Date\" 等命名格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format 使用與儲存格數字格式相同的代碼，如 \"#,##0.00\" 或 \"yyyy-mm-dd\"，也支援 \"Currency\"、\"Short Date\" 等具名格式。"
          }
        }
      }
    },
    "Help.Functions.Information" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Information"
