    "Help.Functions.InteractionNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell opens web and app links once you agree; SendKeys shows its keys instead of typing them; AppActivate does nothing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell はあなたが許可すると Web やアプリのリンクを開きます。SendKeys はキーを入力する代わりに表示し、AppActivate は何もしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell은 사용자가 허용하면 웹 및 앱 링크를 엽니다. SendKeys는 키를 입력하는 대신 보여 주며, AppActivate는 아무것도 하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 在你同意后打开网页和应用链接；SendKeys 会显示按键而不是输入；AppActivate 不执行任何操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 在你同意後打開網頁和 App 連結；SendKeys 會顯示按鍵而不是輸入；AppActivate 不執行任何動作。"
          }
        }
      }
    },
