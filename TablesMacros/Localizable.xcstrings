    "Macro.Unavailable.GetObject" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject isn’t available in Tables. There are no other applications or their files for a macro to connect to."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables では GetObject を使用できません。マクロから接続できる他のアプリケーションやそのファイルはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables에서는 GetObject를 사용할 수 없습니다. 매크로가 연결할 다른 응용 프로그램이나 그 파일이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 不支持 GetObject。没有可供宏连接的其他应用程序或其文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 不支援 GetObject。沒有可供巨集連接的其他應用程式或其檔案。"
          }
        }
      }
    },
    "Macro.Unavailable.Shell" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Tables, Shell can only open web and app links, such as https:// addresses. It can’t start programs or open files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables の Shell で開けるのは、https:// で始まるアドレスなどの Web やアプリのリンクだけです。プログラムの起動やファイルを開くことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables에서 Shell은 https:// 주소 같은 웹 및 앱 링크만 열 수 있습니다. 프로그램을 시작하거나 파일을 열 수는 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Tables 中，Shell 只能打开网页和应用链接（例如 https:// 地址），不能启动程序或打开文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Tables 中，Shell 只能打開網頁和 App 連結（例如 https:// 位址），不能啟動程式或打開檔案。"
          }
        }
      }
    },
