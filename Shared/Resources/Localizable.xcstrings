    "Macros.Confirm.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macro can change anything in this workbook. Only run macros from people you trust. You can undo what a macro did."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロはこのブックの内容を自由に変更できます。信頼できる相手から受け取ったマクロだけを実行してください。マクロによる変更は取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 이 통합 문서의 모든 내용을 변경할 수 있습니다. 신뢰할 수 있는 사람이 만든 매크로만 실행하십시오. 매크로가 변경한 내용은 실행 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏可以更改此工作簿中的任何内容。请只运行来自你信任的人的宏。宏所做的更改可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集可以更改此活頁簿中的任何內容。請只執行來自你信任的人的巨集。巨集所做的更改可以還原。"
          }
        }
      }
    },
