    "Help.Search.NoResults.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn’t in the help book. If a macro uses something Tables can’t run, it says so when that line is reached."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はヘルプに載っていません。Tables で実行できないものをマクロが使っている場合は、その行に来たときにメッセージが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 도움말에 없습니다. 매크로가 Tables에서 실행할 수 없는 항목을 사용하면 해당 줄에 도달할 때 알려 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮助中没有“%@”。如果宏使用了 Tables 无法运行的内容，运行到那一行时会给出提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助說明中沒有「%@」。如果巨集使用了 Tables 無法執行的內容，執行到那一行時會顯示提示。"
          }
        }
      }
    },
