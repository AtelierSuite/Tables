        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'은(는) B2 같은 셀 주소가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是单元格地址（如 B2）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是儲存格位址（如 B2）。"
          }
        }
      }
    },
