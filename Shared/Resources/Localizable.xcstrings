    "Intent.Save.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes a workbook back to the file it came from, or to a file you choose. The file's name decides whether it is saved as Excel, CSV or TSV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークブックを元のファイル、または選んだファイルに書き込みます。Excel、CSV、TSV のどれで保存するかはファイル名で決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 문서를 원래 파일이나 선택한 파일에 다시 씁니다. 파일 이름에 따라 Excel, CSV, TSV 중 어느 형식으로 저장할지 정해집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将工作簿写回其来源文件或你选择的文件。文件名决定存储为 Excel、CSV 还是 TSV。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將活頁簿寫回其來源檔案或你選擇的檔案。檔名決定儲存為 Excel、CSV 還是 TSV。"
          }
        }
      }
    },
