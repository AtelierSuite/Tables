    "Macros.Create.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This workbook has no macros yet. Creating them adds a module for the workbook and each sheet, as Excel does, and a module to write your first macro in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このブックにはまだマクロがありません。作成すると、Excel と同じようにブックと各シートのモジュール、そして最初のマクロを書くためのモジュールが追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 통합 문서에는 아직 매크로가 없습니다. 매크로를 만들면 Excel처럼 통합 문서와 각 시트의 모듈, 그리고 첫 매크로를 작성할 모듈이 추가됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作簿还没有宏。创建后会像 Excel 一样，为工作簿和每个工作表添加模块，并添加一个用于编写第一个宏的模块。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此活頁簿還沒有巨集。建立後會像 Excel 一樣，為活頁簿和每個工作表加入模組，並加入一個用來撰寫第一個巨集的模組。"
          }
        }
