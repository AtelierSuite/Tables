    "Intent.SetCell.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enters a value into a cell as if typed. Start with = for a formula."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力したのと同じようにセルに値を入れます。数式は = で始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 것처럼 셀에 값을 넣습니다. 수식은 =로 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像键入一样在单元格中输入值。公式以 = 开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像輸入一樣在儲存格中輸入值。公式以 = 開頭。"
          }
        }
      }
    },
