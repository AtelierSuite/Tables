# Response headers for the published site (Cloudflare static assets).
# Everything is revalidated on each load (Cloudflare's default); the service
# worker keeps the app offline, and build/version.json says when there's a new version.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

/build/version.js
  Cache-Control: no-cache

/build/version.json
  Cache-Control: no-cache
