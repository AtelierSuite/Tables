    "Intent.OpenInTables.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a workbook in Tables. One read from a file opens that file, with the shortcut's changes saved into it; a new one is saved in Tables' documents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables でワークブックを開きます。ファイルから読み込んだものは、ショートカットでの変更を保存したうえでそのファイルを開きます。新規のものは Tables の書類に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables에서 통합 문서를 엽니다. 파일에서 읽은 통합 문서는 단축어의 변경 사항을 저장한 뒤 그 파일을 열고, 새 통합 문서는 Tables의 문서에 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Tables 中打开工作簿。从文件读取的工作簿会先存储快捷指令所做的更改，再打开该文件；新工作簿会存储在 Tables 的文稿中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Tables 中打開活頁簿。從檔案讀取的活頁簿會先儲存捷徑所做的變更，再打開該檔案；新活頁簿會儲存在 Tables 的文件中。"
          }
        }
      }
    },
