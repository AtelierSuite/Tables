    "Macros.Files.Explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This workbook’s macros read and write files in this folder, and nowhere else. Paths in code are relative to it, and ThisWorkbook.Path returns it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このブックのマクロは、このフォルダ内でのみファイルを読み書きします。コード内のパスはこのフォルダを基準とし、ThisWorkbook.Path はこのフォルダを返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 통합 문서의 매크로는 이 폴더 안에서만 파일을 읽고 씁니다. 코드의 경로는 이 폴더를 기준으로 하며, ThisWorkbook.Path는 이 폴더를 반환합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作簿的宏只在这个文件夹中读写文件。代码中的路径以此文件夹为准，ThisWorkbook.Path 返回此文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此活頁簿的巨集只在這個資料夾中讀寫檔案。程式碼中的路徑以此資料夾為準，ThisWorkbook.Path 會傳回此資料夾。"
          }
        }
      }
    },
