    "Help.Functions.UnavailableNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject connects to other applications and Scripting.FileSystemObject reaches the whole file system; neither exists for macros here. Use the file statements, which work in the workbook’s own folder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject は他のアプリケーションに接続し、Scripting.FileSystemObject はファイルシステム全体にアクセスしますが、どちらもここではマクロから使用できません。ブック専用のフォルダで動作するファイルステートメントを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject는 다른 응용 프로그램에 연결하고 Scripting.FileSystemObject는 전체 파일 시스템에 접근하지만, 둘 다 여기서는 매크로가 사용할 수 없습니다. 통합 문서 전용 폴더에서 작동하는 파일 문을 사용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject 用于连接其他应用程序，Scripting.FileSystemObject 可访问整个文件系统；在这里，宏两者都无法使用。请使用在工作簿专属文件夹中工作的文件语句。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GetObject 用於連接其他應用程式，Scripting.FileSystemObject 可存取整個檔案系統；在這裡，巨集兩者都無法使用。請使用在活頁簿專屬資料夾中運作的檔案陳述式。"
          }
        }
      }
    },
