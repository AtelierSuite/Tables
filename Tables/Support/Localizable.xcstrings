    "Macros.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macros run inside this workbook and its own folder of files. They open web links only with your permission, and Undo takes back everything a macro did to the workbook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロはこのブックと専用のファイルフォルダの中で実行されます。Web リンクを開くのはあなたが許可したときだけで、マクロによるブックへの変更はすべて取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 이 통합 문서와 전용 파일 폴더 안에서 실행됩니다. 웹 링크는 사용자가 허용할 때만 열리며, 매크로가 통합 문서에 한 변경 사항은 모두 실행 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏在此工作簿及其专属文件夹内运行。只有经你允许才会打开网页链接，宏对工作簿所做的一切都可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集在此活頁簿及其專屬資料夾內執行。只有經你允許才會打開網頁連結，巨集對活頁簿所做的一切都可以還原。"
          }
        }
      }
    },
