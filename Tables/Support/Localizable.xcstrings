    "Automation.Error.CannotOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables couldn't open the workbook. Try again once Tables has finished launching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables でワークブックを開けませんでした。Tables の起動が完了してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables에서 통합 문서를 열 수 없습니다. Tables 실행이 끝난 뒤 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 无法打开工作簿。请在 Tables 启动完成后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables 無法打開活頁簿。請在 Tables 啟動完成後再試一次。"
          }
        }
      }
    },
    "Automation.Error.InvalidCell" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn't a cell address, such as B2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はセル番地（B2 など）ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'은(는) B2 같은 셀 주소가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是单元格地址（如 B2）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是儲存格位址（如 B2）。"
          }
        }
      }
    },
    "Automation.Error.InvalidColumn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn't a column in the range."
          }
        },
        "ja" : {
          "stringUnit" : {
