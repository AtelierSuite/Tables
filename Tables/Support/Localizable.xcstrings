    "Help.Language.UnavailableNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UserForms and Windows functions don’t exist on Apple devices. Excel’s own events, such as Workbook_Open, can be written and kept but don’t run by themselves; events your classes raise do."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーフォームと Windows の関数は Apple 製デバイスにはありません。Workbook_Open などの Excel 自体のイベントは記述して保存できますが、自動では実行されません。独自のクラスが発生させるイベントは動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 정의 폼과 Windows 함수는 Apple 기기에 없습니다. Workbook_Open 같은 Excel 자체 이벤트는 작성하고 저장할 수 있지만 자동으로 실행되지 않습니다. 직접 만든 클래스가 발생시키는 이벤트는 작동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 设备上没有用户窗体和 Windows 函数。Workbook_Open 等 Excel 自身的事件可以编写和保存，但不会自动运行；你的类引发的事件可以正常工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 裝置上沒有使用者表單和 Windows 函數。Workbook_Open 等 Excel 本身的事件可以撰寫和保存，但不會自動執行；你的類別引發的事件可以正常運作。"
          }
        }
      }
    },
    "Help.Language.Variables" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
