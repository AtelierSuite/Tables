      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tables can’t type into other apps, so here are the keys this macro tried to send. You can copy them."
          }
        },
        "ja" : {
